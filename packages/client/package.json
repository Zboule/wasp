{
  "name": "@zboule/wasp-client",
  "version": "0.2.0",
  "description": "Call wasp from your API: post messages to a thread, read its feed, interrupt, cancel.",
  "keywords": [
    "wasp",
    "agent",
    "claude",
    "agentcore",
    "client"
  ],
  "author": "Jordane Cure",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zboule/wasp.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/Zboule/wasp#readme",
  "bugs": "https://github.com/Zboule/wasp/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-kms": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@zboule/wasp-protocol": "workspace:*"
  },
  "devDependencies": {
    "@zboule/wasp-store": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
