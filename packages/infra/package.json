{
  "name": "@zboule/wasp-infra",
  "version": "0.4.2",
  "description": "WaspAgent, the SST component that deploys wasp into your AWS account: AgentCore runtime, storage, waker and IAM.",
  "keywords": [
    "wasp",
    "agent",
    "claude",
    "agentcore",
    "sst",
    "pulumi",
    "aws"
  ],
  "author": "Jordane Cure",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zboule/wasp.git",
    "directory": "packages/infra"
  },
  "homepage": "https://github.com/Zboule/wasp#readme",
  "bugs": "https://github.com/Zboule/wasp/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "image",
    "assets",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "assets": "node scripts/assets.mjs",
    "build": "pnpm assets && tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@zboule/wasp-protocol": "workspace:*"
  },
  "devDependencies": {
    "@pulumi/aws": "6.66.2",
    "@pulumi/aws-native": "1.72.0",
    "@pulumi/docker-build": "0.0.14",
    "@pulumi/pulumi": "3.210.0",
    "@pulumiverse/time": "0.1.1",
    "@types/aws-lambda": "^8.10.164",
    "esbuild": "^0.25.12"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
