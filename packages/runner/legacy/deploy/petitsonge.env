# Petit Songe runtime target (perso / eu-west-1). Source before the deploy scripts:
#   source deploy/petitsonge.env && bash deploy/20-iam-role.sh && ...
export AWS_PROFILE=perso
export AWS_REGION=eu-west-1
export REPO=petitsonge-agent
export RUNTIME_NAME=petitsonge_agent
export ROLE_NAME=petitsonge-agent-exec
export STATE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-deploy/petitsonge.env}")" && pwd)/.state-petitsonge
export AGENT_AUTH_MODE=max
export AGENT_MODEL=claude-sonnet-5
export AGENT_SECRET_SSM_PARAM=/petitsonge/agent/oauth-token
# Set once petitsonge infra exists (then re-run 30-create-runtime.sh to bump the version):
#   export AGENT_SESSIONSTORE_S3_BUCKET=... AGENT_EVENT_CALLBACK_URL=... AGENT_EVENT_CALLBACK_SECRET=...

# The MCP server name became configurable (AGENT_MCP_NAME) so a second service
# does not get its tools prefixed `mcp__petitsonge__`. Petit Songe's live
# runtime pins its image by digest and is unaffected, but a REBUILD from this
# commit must set this or its tool names change under it.
export AGENT_MCP_NAME=petitsonge
