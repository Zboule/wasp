# Les Vieilles Branches runtime target (perso / eu-west-1). Source before the
# deploy scripts:
#   source deploy/vieillesbranches.env && bash deploy/10-push-ecr.sh
#
# The runtime itself is declared in ~/dev/vieillesbranches/infra, as an SST
# `awsnative.bedrockagentcore.Runtime` pointing at the image digest this pushes.
# These scripts only build and publish the engine image.
export AWS_PROFILE=perso
export AWS_REGION=eu-west-1
export REPO=vieillesbranches-agent
export RUNTIME_NAME=vieillesbranches_agent
export ROLE_NAME=vieillesbranches-agent-exec
export STATE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-deploy/vieillesbranches.env}")" && pwd)/.state-vieillesbranches
export AGENT_AUTH_MODE=max
export AGENT_MODEL=claude-sonnet-5
export AGENT_SECRET_SSM_PARAM=/vieillesbranches/agent/oauth-token
# Tools prefix: mcp__vieillesbranches__get_tree, and so on.
export AGENT_MCP_NAME=vieillesbranches
