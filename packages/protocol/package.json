{
  "name": "@zboule/wasp-protocol",
  "version": "0.1.0",
  "description": "The shared contracts of wasp: AG-UI feed events, the queue, thread state and the store interface.",
  "keywords": [
    "wasp",
    "agent",
    "ag-ui",
    "protocol"
  ],
  "author": "Jordane Cure",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zboule/wasp.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/Zboule/wasp#readme",
  "bugs": "https://github.com/Zboule/wasp/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
