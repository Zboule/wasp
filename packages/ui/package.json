{
  "name": "@zboule/wasp-ui",
  "version": "0.5.1",
  "description": "The chat UI for a wasp thread: a headless session, React building blocks with themes and plug points, and a one-file embed.",
  "keywords": [
    "wasp",
    "agent",
    "chat",
    "react",
    "ag-ui"
  ],
  "author": "Jordane Cure",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zboule/wasp.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Zboule/wasp#readme",
  "bugs": "https://github.com/Zboule/wasp/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/react/styles.css",
    "./themes/shadcn.css": "./src/themes/shadcn.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom && cp src/react/styles.css dist/styles.css && mkdir -p dist/themes && cp src/themes/*.css dist/themes/ && esbuild src/embed.tsx --bundle --format=iife --global-name=WaspChat --loader:.css=text --jsx=automatic --minify --define:process.env.NODE_ENV='\"production\"' --outfile=dist/wasp-chat.js",
    "playground": "node playground/serve.mjs"
  },
  "dependencies": {
    "@zboule/wasp-protocol": "workspace:*",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./themes/shadcn.css": "./dist/themes/shadcn.css",
      "./embed": "./dist/wasp-chat.js"
    }
  }
}
